# Anthropic API Key für Claude-basierte Plan-Generierung.
# Hol dir den Key unter https://console.anthropic.com/settings/keys
# Datei umbenennen zu `.env` (ohne .example) und Key einsetzen.

ANTHROPIC_API_KEY=sk-ant-...

# Optionaler Shared-Secret-Token für /api/generate-plan (Schutz gegen Bots beim
# Hosten). Wenn gesetzt, muss das Frontend den X-App-Token-Header mitschicken
# (passiert automatisch). Lokal optional. Beliebige zufällige Zeichenkette –
# z. B. `openssl rand -hex 32`.
# APP_API_TOKEN=
